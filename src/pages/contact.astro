---
import Layout from '../layouts/Layout.astro'; import ContentPage from '../components/ContentPage.astro';
---
<Layout title="Contact Tip Calculator" description="Contact Tip Calculator with general questions, bug reports, calculation issues, or feature suggestions."><ContentPage title="Contact" intro="Have a question or found something that needs attention? Send a note and include enough detail for us to understand the context."><a class="email-button" href="mailto:uranuragsingh@gmail.com">Email us</a><div class="contact-grid"><section><h2>General questions</h2><p>Ask about using the calculator, the tipping guides, supported currencies, or how a result is displayed.</p></section><section><h2>Bug or calculation issue</h2><p>Include the bill amount, currency, tip percentage, number of people, and options selected, along with the result you expected. Do not send sensitive payment information.</p></section><section><h2>Feature suggestions</h2><p>Tell us what problem a proposed feature would solve and how you would expect it to work. Suggestions about accessibility and clarity are especially useful.</p></section></div><p class="contact-note">Email: <a href="mailto:uranuragsingh@gmail.com">uranuragsingh@gmail.com</a></p></ContentPage></Layout>
<style>.email-button{display:inline-flex;margin:4px 0 26px;padding:12px 18px;border-radius:11px;background:var(--accent-strong);color:#fff!important;font-weight:800;text-decoration:none}.contact-grid{display:grid;gap:18px}.contact-grid section{padding:17px;border:1px solid var(--line);border-radius:14px;background:var(--surface-2)}.contact-grid h2{margin-top:0}.contact-note{margin-top:26px!important}@media(min-width:700px){.contact-grid{grid-template-columns:repeat(3,1fr)}}</style>
