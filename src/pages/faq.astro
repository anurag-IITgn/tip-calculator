---
import Layout from '../layouts/Layout.astro'; import ContentPage from '../components/ContentPage.astro';
const questions = [{q:'Is 20% tip common in the USA?',a:'For good full-service restaurant service, 20% is a common choice. It is not a requirement, and an included service charge changes the calculation.'},{q:'What is a 20% tip on $50?',a:'It is $10, making the subtotal plus tip $60 before other charges.'},{q:'Is 10% tip disrespectful?',a:'Not automatically. Expectations depend on the setting; 10% is below the common restaurant range in the U.S., while takeout tipping is optional.'},{q:'Is it rude not to tip?',a:'In U.S. full-service restaurants, leaving no tip is unusual unless service was seriously poor or a gratuity was included. Many other situations are discretionary.'},{q:'What is the 20% tip trick?',a:'Find 10% by moving the decimal one place left, then double it. The calculator does the exact arithmetic and splitting for you.'}];
---
<Layout title="Tip Calculator FAQ | Common Tipping Questions" description="Answers to common questions about tip percentages, restaurant tipping, splitting bills, and calculating totals."><ContentPage title="Tip calculator FAQ" intro="Straightforward answers to common questions about percentages, service, and using a tip calculator.">{questions.map(({q,a}) => <details><summary>{q}</summary><p>{a}</p></details>)}<h2>Need a number?</h2><p><a href="/">Return to the tip calculator</a> to enter a bill, choose a percentage, split it, and copy the result.</p></ContentPage></Layout>
