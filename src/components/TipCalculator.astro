<script>
	if (false) {
	class TipCalculator extends HTMLElement {
		private billInput!: HTMLInputElement; private customTipInput!: HTMLInputElement; private customSlider!: HTMLInputElement; private customWrap!: HTMLElement; private tipButtons!: HTMLButtonElement[]; private customButton!: HTMLButtonElement; private people = 1; private tipPercent = 20; private serviceCharge!: HTMLInputElement; private roundUp!: HTMLInputElement; private peopleOutput!: HTMLOutputElement; private peopleLabel!: HTMLElement; private perPersonOutput!: HTMLOutputElement; private resultContext!: HTMLElement; private splitDetail!: HTMLElement; private tipAmount!: HTMLElement; private totalBill!: HTMLElement; private roundingNote!: HTMLElement; private copyButton!: HTMLButtonElement; private copyLabel!: HTMLElement; private copyStatus!: HTMLElement;
		connectedCallback() {
			this.billInput=this.querySelector('#bill')!;this.customTipInput=this.querySelector('#custom-tip')!;this.customSlider=this.querySelector('[data-custom-slider]')!;this.customWrap=this.querySelector('[data-custom-wrap]')!;this.tipButtons=Array.from(this.querySelectorAll('[data-tip]'));this.customButton=this.querySelector('[data-custom-button]')!;this.serviceCharge=this.querySelector('[data-service-charge]')!;this.roundUp=this.querySelector('[data-round-up]')!;this.peopleOutput=this.querySelector('[data-people-output]')!;this.peopleLabel=this.querySelector('[data-people-label]')!;this.perPersonOutput=this.querySelector('[data-per-person]')!;this.resultContext=this.querySelector('[data-result-context]')!;this.splitDetail=this.querySelector('[data-split-detail]')!;this.tipAmount=this.querySelector('[data-tip-amount]')!;this.totalBill=this.querySelector('[data-total-bill]')!;this.roundingNote=this.querySelector('[data-rounding-note]')!;this.copyButton=this.querySelector('[data-copy]')!;this.copyLabel=this.querySelector('[data-copy-label]')!;this.copyStatus=this.querySelector('[data-copy-status]')!;
			this.billInput.addEventListener('input',()=>this.update());this.customTipInput.addEventListener('input',()=>this.setCustomTip(this.customTipInput.value));this.customSlider.addEventListener('input',()=>this.setCustomTip(this.customSlider.value));this.tipButtons.forEach(button=>button.addEventListener('click',()=>{this.customWrap.hidden=true;this.tipPercent=Number(button.dataset.tip);this.setSelectedTip(button);this.update();}));this.customButton.addEventListener('click',()=>{this.customWrap.hidden=false;this.tipButtons.forEach(button=>button.setAttribute('aria-pressed','false'));this.customButton.setAttribute('aria-pressed','true');this.customTipInput.value=String(this.tipPercent);this.customSlider.value=String(this.tipPercent);this.customTipInput.focus();this.update();});this.querySelector<HTMLButtonElement>('[data-people-decrease]')!.addEventListener('click',()=>{this.people=Math.max(1,this.people-1);this.update();});this.querySelector<HTMLButtonElement>('[data-people-increase]')!.addEventListener('click',()=>{this.people+=1;this.update();});[this.serviceCharge,this.roundUp].forEach(input=>input.addEventListener('change',()=>this.update()));this.copyButton.addEventListener('click',()=>this.copyResult());this.update();
