		private parseNumber(value:string){const parsed=Number.parseFloat(value);return Number.isFinite(parsed)&&parsed>=0?parsed:0;} private format(cents:number){return new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(cents/100);} private setCustomTip(value:string){this.tipPercent=Math.min(100,this.parseNumber(value));this.customTipInput.value=value;this.customSlider.value=String(this.tipPercent);this.update();} private setSelectedTip(selected:HTMLButtonElement){this.tipButtons.forEach(button=>button.setAttribute('aria-pressed',String(button===selected)));this.customButton.setAttribute('aria-pressed','false');}
		private update(){const billCents=Math.round(this.parseNumber(this.billInput.value)*100);const hasBill=billCents>0;const tipCents=this.serviceCharge.checked?0:Math.round(billCents*(this.tipPercent/100));const totalCents=billCents+tipCents;const baseCents=Math.floor(totalCents/this.people);const extraPennyPeople=totalCents%this.people;const roundedEachCents=this.roundUp.checked?Math.ceil(totalCents/this.people/100)*100:0;const displayed=this.roundUp.checked?this.format(roundedEachCents):extraPennyPeople?`${this.format(baseCents)}–${this.format(baseCents+1)}`:this.format(baseCents);const roundingExtra=this.roundUp.checked?roundedEachCents*this.people-totalCents:0;this.peopleOutput.value=String(this.people);this.peopleLabel.textContent=this.people===1?'Just you':`${this.people} people`;this.perPersonOutput.value=displayed;this.tipAmount.textContent=this.format(tipCents);this.totalBill.textContent=this.format(this.roundUp.checked?roundedEachCents*this.people:totalCents);this.resultContext.textContent=this.roundUp.checked?`${this.format(roundedEachCents)} each · ${this.people} ${this.people===1?'person':'people'}`:this.people===1?'For 1 person':`Split between ${this.people} people`;this.copyButton.disabled=!hasBill;this.copyStatus.textContent='';this.copyLabel.textContent='Copy result';if(this.serviceCharge.checked)this.resultContext.textContent+=' · service charge included';if(!this.roundUp.checked&&extraPennyPeople>0){const lowerPeople=this.people-extraPennyPeople;this.splitDetail.hidden=false;this.splitDetail.textContent=`To total exactly ${this.format(totalCents)}: ${extraPennyPeople} ${extraPennyPeople===1?'person pays':'people pay'} ${this.format(baseCents+1)}${lowerPeople?` and ${lowerPeople} ${lowerPeople===1?'person pays':'people pay'} ${this.format(baseCents)}.`:'.'}`;}else this.splitDetail.hidden=true;if(roundingExtra>0){this.roundingNote.hidden=false;this.roundingNote.textContent=`Rounding adds ${this.format(roundingExtra)} across the table (new total ${this.format(roundedEachCents*this.people)}).`;}else this.roundingNote.hidden=true;}
		private async copyResult(){if(this.copyButton.disabled)return;const text=`${this.perPersonOutput.value} per person, ${this.totalBill.textContent} total, including ${this.tipAmount.textContent} tip.`;try{await navigator.clipboard.writeText(text);this.copyLabel.textContent='Copied';this.copyStatus.textContent='Result copied to your clipboard.';}catch{this.copyStatus.textContent='Copy is unavailable in this browser.';}}
	}
	customElements.define('tip-calculator',TipCalculator);
	const toggle=document.querySelector<HTMLButtonElement>('[data-theme-toggle]');const label=document.querySelector<HTMLElement>('[data-theme-label]');const syncTheme=()=>{const light=document.documentElement.dataset.theme==='light';if(toggle){toggle.setAttribute('aria-pressed',String(!light));toggle.setAttribute('aria-label',light?'Switch to dark theme':'Switch to light theme');}if(label)label.textContent=light?'Light':'Dark';};toggle?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='light'?'dark':'light';document.documentElement.dataset.theme=next;try{localStorage.setItem('tip-calculator-theme',next);}catch{}syncTheme();});syncTheme();
	}
</script>

<script>
	class TipCalculator extends HTMLElement {
		private billInput!: HTMLInputElement; private currencySelect!: HTMLSelectElement; private currencySymbol!: HTMLElement; private customTipInput!: HTMLInputElement; private customSlider!: HTMLInputElement; private customWrap!: HTMLElement; private tipButtons!: HTMLButtonElement[]; private customButton!: HTMLButtonElement; private serviceCharge!: HTMLInputElement; private roundUp!: HTMLInputElement; private peopleOutput!: HTMLOutputElement; private peopleLabel!: HTMLElement; private perPersonOutput!: HTMLOutputElement; private resultContext!: HTMLElement; private splitDetail!: HTMLElement; private tipAmount!: HTMLElement; private totalBill!: HTMLElement; private roundingNote!: HTMLElement; private roundingHelp!: HTMLElement; private serviceChargeHelp!: HTMLElement; private copyButton!: HTMLButtonElement; private copyLabel!: HTMLElement; private copyStatus!: HTMLElement; private people=1; private tipPercent=20; private currency='USD';
		private readonly currencies={USD:'$',EUR:'€',GBP:'£',CAD:'C$',AUD:'A$',INR:'₹',JPY:'¥'} as const;
		connectedCallback(){
			this.billInput=this.querySelector('#bill')!;this.currencySelect=this.querySelector('[data-currency]')!;this.currencySymbol=this.querySelector('[data-currency-symbol]')!;this.customTipInput=this.querySelector('#custom-tip')!;this.customSlider=this.querySelector('[data-custom-slider]')!;this.customWrap=this.querySelector('[data-custom-wrap]')!;this.tipButtons=Array.from(this.querySelectorAll('[data-tip]'));this.customButton=this.querySelector('[data-custom-button]')!;this.serviceCharge=this.querySelector('[data-service-charge]')!;this.roundUp=this.querySelector('[data-round-up]')!;this.peopleOutput=this.querySelector('[data-people-output]')!;this.peopleLabel=this.querySelector('[data-people-label]')!;this.perPersonOutput=this.querySelector('[data-per-person]')!;this.resultContext=this.querySelector('[data-result-context]')!;this.splitDetail=this.querySelector('[data-split-detail]')!;this.tipAmount=this.querySelector('[data-tip-amount]')!;this.totalBill=this.querySelector('[data-total-bill]')!;this.roundingNote=this.querySelector('[data-rounding-note]')!;this.roundingHelp=this.querySelector('[data-rounding-help]')!;this.serviceChargeHelp=this.querySelector('[data-service-charge-help]')!;this.copyButton=this.querySelector('[data-copy]')!;this.copyLabel=this.querySelector('[data-copy-label]')!;
			this.copyStatus=this.querySelector('[data-copy-status]')!;try{const saved=localStorage.getItem('tip-calculator-currency');if(saved in this.currencies)this.currency=saved;}catch{}this.currencySelect.value=this.currency;
			this.billInput.addEventListener('input',()=>this.update());this.currencySelect.addEventListener('change',()=>{this.currency=this.currencySelect.value;try{localStorage.setItem('tip-calculator-currency',this.currency)}catch{}this.update();});this.customTipInput.addEventListener('input',()=>this.setCustomTip(this.customTipInput.value));this.customSlider.addEventListener('input',()=>this.setCustomTip(this.customSlider.value));this.tipButtons.forEach(button=>button.addEventListener('click',()=>{this.customWrap.hidden=true;this.tipPercent=Number(button.dataset.tip);this.setSelectedTip(button);this.update();}));this.customButton.addEventListener('click',()=>{this.customWrap.hidden=false;this.tipButtons.forEach(button=>button.setAttribute('aria-pressed','false'));this.customButton.setAttribute('aria-pressed','true');this.customTipInput.value=String(this.tipPercent);this.customSlider.value=String(this.tipPercent);this.customTipInput.focus();this.update();});this.querySelector<HTMLButtonElement>('[data-people-decrease]')!.addEventListener('click',()=>{this.people=Math.max(1,this.people-1);this.update();});this.querySelector<HTMLButtonElement>('[data-people-increase]')!.addEventListener('click',()=>{this.people+=1;this.update();});[this.serviceCharge,this.roundUp].forEach(input=>input.addEventListener('change',()=>this.update()));this.copyButton.addEventListener('click',()=>this.copyResult());this.update();
		}
		private fractionDigits(){return new Intl.NumberFormat('en-US',{style:'currency',currency:this.currency}).resolvedOptions().maximumFractionDigits;}
		private unit(){return 10**this.fractionDigits();} private parseNumber(value:string){const parsed=Number.parseFloat(value);return Number.isFinite(parsed)&&parsed>=0?parsed:0;}
		private format(units:number){const parts=new Intl.NumberFormat('en-US',{style:'currency',currency:this.currency}).formatToParts(units/this.unit());return parts.map(part=>part.type==='currency'?this.currencies[this.currency as keyof typeof this.currencies]:part.value).join('');}
		private setCustomTip(value:string){this.tipPercent=Math.min(100,this.parseNumber(value));this.customTipInput.value=value;this.customSlider.value=String(this.tipPercent);this.update();} private setSelectedTip(selected:HTMLButtonElement){this.tipButtons.forEach(button=>button.setAttribute('aria-pressed',String(button===selected)));this.customButton.setAttribute('aria-pressed','false');}
		private update(){const unit=this.unit();const billUnits=Math.round(this.parseNumber(this.billInput.value)*unit);const hasBill=billUnits>0;const tipUnits=this.serviceCharge.checked?0:Math.round(billUnits*(this.tipPercent/100));const totalUnits=billUnits+tipUnits;const baseUnits=Math.floor(totalUnits/this.people);const adjustedShares=totalUnits%this.people;const roundedEachUnits=this.roundUp.checked?Math.ceil(totalUnits/this.people/unit)*unit:0;const roundingExtra=this.roundUp.checked?roundedEachUnits*this.people-totalUnits:0;const uneven=!this.roundUp.checked&&adjustedShares>0;let displayed=this.roundUp.checked?this.format(roundedEachUnits):this.format(baseUnits);if(uneven){if(this.people<=4){displayed=Array.from({length:this.people},(_,index)=>this.format(index<adjustedShares?baseUnits+1:baseUnits)).join(' / ');}else displayed=`${this.format(baseUnits+1)} each`;}
			this.currencySymbol.textContent=this.currencies[this.currency as keyof typeof this.currencies];this.billInput.placeholder=this.fractionDigits()?'0.00':'0';this.roundingHelp.textContent='To the next whole currency unit';this.serviceChargeHelp.textContent=`Set the added tip to ${this.format(0)}.`;this.peopleOutput.value=String(this.people);this.peopleLabel.textContent=this.people===1?'Just you':`${this.people} people`;this.perPersonOutput.value=displayed;this.tipAmount.textContent=this.format(tipUnits);this.totalBill.textContent=this.format(this.roundUp.checked?roundedEachUnits*this.people:totalUnits);this.resultContext.textContent=this.roundUp.checked?`${this.format(roundedEachUnits)} each · ${this.people} ${this.people===1?'person':'people'}`:this.people===1?'For 1 person':`Split between ${this.people} people`;if(this.serviceCharge.checked)this.resultContext.textContent+=' · service charge included';this.splitDetail.hidden=!uneven;if(uneven){const adjustedLabel=`${adjustedShares===1?'One share':`${adjustedShares} shares`} adjusted by ${this.format(1)} to match the total.`;this.splitDetail.textContent=this.people<=4?`Split adjusted by ${this.format(1)} to match the total.`:adjustedLabel;}this.roundingNote.hidden=roundingExtra===0;if(roundingExtra>0)this.roundingNote.textContent=`Rounding adds ${this.format(roundingExtra)} across the table (new total ${this.format(roundedEachUnits*this.people)}).`;this.copyButton.disabled=!hasBill;this.copyStatus.textContent='';this.copyLabel.textContent='Copy result';}
		private async copyResult(){if(this.copyButton.disabled)return;const text=`${this.perPersonOutput.value} per person, ${this.totalBill.textContent} total, including ${this.tipAmount.textContent} tip.`;try{await navigator.clipboard.writeText(text);this.copyLabel.textContent='Copied';this.copyStatus.textContent='Result copied to your clipboard.';}catch{this.copyStatus.textContent='Copy is unavailable in this browser.';}}
	}
	customElements.define('tip-calculator',TipCalculator);
	const toggle=document.querySelector<HTMLButtonElement>('[data-theme-toggle]');const label=document.querySelector<HTMLElement>('[data-theme-label]');const syncTheme=()=>{const light=document.documentElement.dataset.theme==='light';if(toggle){toggle.setAttribute('aria-pressed',String(!light));toggle.setAttribute('aria-label',light?'Switch to dark theme':'Switch to light theme');}if(label)label.textContent=light?'Light':'Dark';};toggle?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='light'?'dark':'light';document.documentElement.dataset.theme=next;try{localStorage.setItem('tip-calculator-theme',next)}catch{}syncTheme();});syncTheme();
</script>
