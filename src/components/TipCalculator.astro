head input{width:68px;border:0;border-bottom:1px solid var(--line);outline:0;background:transparent;color:var(--ink);font:inherit;font-size:1.05rem;font-weight:800;text-align:right}.tip-slider{width:100%;margin:14px 0 4px;accent-color:var(--accent-strong);cursor:pointer}.slider-labels{display:flex;justify-content:space-between;color:var(--muted);font-size:.7rem}.stepper{display:grid;grid-template-columns:54px 1fr 54px;align-items:center;margin-top:9px;border:1.5px solid var(--line);border-radius:13px;overflow:hidden}.stepper button{border:0;border-radius:0;font-size:1.5rem}.stepper button:first-child{border-right:1.5px solid var(--line)}.stepper button:last-child{border-left:1.5px solid var(--line)}.stepper output{text-align:center;color:var(--ink);font-size:1.08rem;font-weight:800}.rounding-control{display:flex;align-items:center;gap:11px;margin:-5px 0 25px;padding:12px 13px;border:1px solid var(--line);border-radius:13px;background:var(--surface-2);cursor:pointer}.rounding-control strong,.rounding-control small{display:block}.rounding-control small{margin-top:3px;color:var(--muted);font-size:.75rem;font-weight:500}.rounding-control input{position:absolute;opacity:0}.switch{width:39px;height:22px;flex:0 0 auto;border-radius:999px;background:#64748b;transition:background .15s}.switch::after{display:block;width:16px;height:16px;margin:3px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.2);content:'';transition:transform .15s}.rounding-control input:checked+.switch{background:var(--accent-strong)}.rounding-control input:checked+.switch::after{transform:translateX(17px)}.options{border-top:1px solid var(--line);padding-top:19px}.options summary{display:flex;align-items:center;justify-content:space-between;color:var(--ink);font-size:.92rem;font-weight:800;cursor:pointer;list-style:none}.options summary::-webkit-details-marker{display:none}.options summary::after{content:'+';color:var(--accent);font-size:1.25rem;font-weight:500}.options[open] summary::