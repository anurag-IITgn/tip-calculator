<main class="page-shell">
	<section class="calculator" aria-labelledby="page-title">
		<header class="intro">
			<div>
				<p class="eyebrow">Restaurant tip calculator</p>
				<h1 id="page-title">Tip calculator, without the mental math.</h1>
				<p>Enter the bill, choose a tip, and see what everyone pays.</p>
			</div>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme" aria-pressed="true"><span aria-hidden="true">☀</span><span data-theme-label>Dark</span></button>
		</header>

		<tip-calculator>
			<div class="calculator-grid">
				<div class="inputs-panel">
					<div class="field-group">
						<div class="field-heading"><label for="bill">Bill amount</label><label class="currency-select" for="currency"><span class="sr-only">Currency</span><select id="currency" data-currency aria-label="Currency"><option value="USD">USD — $</option><option value="EUR">EUR — €</option><option value="GBP">GBP — £</option><option value="CAD">CAD — C$</option><option value="AUD">AUD — A$</option><option value="INR">INR — ₹</option><option value="JPY">JPY — ¥</option></select></label></div>
						<div class="money-input"><span data-currency-symbol aria-hidden="true">$</span><input id="bill" name="bill" type="text" inputmode="decimal" autocomplete="off" placeholder="0.00" aria-describedby="bill-help" /></div>
						<p id="bill-help" class="field-help">Enter your restaurant bill.</p>
					</div>

					<fieldset class="field-group tip-fieldset">
						<legend>Tip percentage</legend>
						<div class="tip-options" role="group" aria-label="Tip percentage">
							<button type="button" data-tip="15">15%</button><button type="button" data-tip="18">18%</button><button type="button" data-tip="20" aria-pressed="true">20%</button><button type="button" data-tip="25">25%</button><button type="button" data-custom-button aria-pressed="false">Custom</button>
						</div>
						<div class="custom-tip" data-custom-wrap hidden>
							<div class="custom-tip-head"><strong>Custom tip</strong><label for="custom-tip"><input id="custom-tip" type="number" min="0" max="100" step="0.1" inputmode="decimal" value="20" /><span>%</span></label></div>
							<input class="tip-slider" data-custom-slider type="range" min="0" max="100" step="0.5" value="20" aria-label="Custom tip percentage" />
							<div class="slider-labels" aria-hidden="true"><span>0%</span><span>50%</span><span>100%</span></div>
						</div>
					</fieldset>

					<div class="field-group">
						<span class="field-label">Split between</span>
						<div class="stepper" aria-label="Number of people"><button type="button" data-people-decrease aria-label="Decrease number of people">−</button><output data-people-output aria-live="polite">1</output><button type="button" data-people-increase aria-label="Increase number of people">+</button></div>
						<p class="field-help" data-people-label>Just you</p>
					</div>

					<label class="rounding-control"><input type="checkbox" data-round-up /><span class="switch" aria-hidden="true"></span><span><strong>Round each person's share up</strong><small data-rounding-help>To the next whole currency unit</small></span></label>

					<details class="options"><summary>More options</summary><div class="option-list"><label class="option-row"><span><strong>Service charge already included</strong><small data-service-charge-help>Set the added tip to $0.00.</small></span><input type="checkbox" data-service-charge /></label></div></details>
				</div>

				<aside class="results-panel" aria-labelledby="result-heading">
					<p class="result-kicker" id="result-heading">Amount per person</p>
					<output class="per-person" data-per-person aria-live="polite">$0.00</output>
					<p class="result-context" data-result-context>For 1 person</p>
					<p class="split-detail" data-split-detail hidden></p>
					<dl class="result-breakdown"><div><dt>Tip amount</dt><dd data-tip-amount>$0.00</dd></div><div><dt>Total bill</dt><dd data-total-bill>$0.00</dd></div></dl>
					<p class="rounding-note" data-rounding-note hidden></p>
					<button type="button" class="copy-button" data-copy disabled><span aria-hidden="true">↗</span> <span data-copy-label>Copy result</span></button><p class="copy-status" data-copy-status aria-live="polite"></p>
				</aside>
			</div>
		</tip-calculator>
	</section>

</main>

<style>
