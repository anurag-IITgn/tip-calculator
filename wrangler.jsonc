{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "microtool-test",
	"compatibility_date": "2026-08-14",
	"assets": {
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "tipcalculatorlive.com",
			"custom_domain": true
		},
		{
			"pattern": "www.tipcalculatorlive.com",
			"custom_domain": true
		}
	]
}